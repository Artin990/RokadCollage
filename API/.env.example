# Server Configuration
PORT=5000
DATA_BASE=mongodb://127.0.0.1:27017/RokadCollage

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# SMS Gateway (LimoSMS)
SMS_KEY=your_limosms_api_key_here

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:5173/wallet/verify

# SpotPlayer API
SPOTPLAYER_API_KEY=your_spotplayer_api_key_here
SPOTPLAYER_DOWNLOAD_DOMAIN=https://dl.spotplayer.ir
SPOTPLAYER_TEST_MODE=true

# Optional CORS Origins (comma-separated, defaults to all if empty)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
